{
  "name": "allot",
  "private": true,
  "type": "module",
  "scripts": {
    "build:program": "anchor build --arch v0 && pnpm idl",
    "idl": "cp target/idl/allot.json sdk/src/idl/allot.json && cp target/types/allot.ts sdk/src/idl/allot.ts",
    "test": "cargo test",
    "dev": "pnpm --filter app dev",
    "build": "pnpm --filter app build",
    "seed": "pnpm --filter keeper seed",
    "keeper": "pnpm --filter keeper start",
    "e2e": "pnpm --filter keeper e2e",
    "e2e:lend": "pnpm --filter keeper e2e:lend",
    "fixtures": "scripts/fetch-jupiter-fixtures.sh",
    "validator": "scripts/local-validator.sh",
    "build:functions": "node scripts/bundle-functions.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@solana/attestation": "^2.1.0",
    "@solana/kit": "^8.6.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
