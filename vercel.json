{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter app build && node scripts/bundle-functions.mjs",
  "outputDirectory": "app/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
